# ==============================================================================
# Curio 项目环境变量配置文件模板 (.env.example)
# 复制此文件并重命名为 .env，然后填写具体的配置参数
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务配置 (Basic Server Settings)
# ------------------------------------------------------------------------------
# 运行环境: development (开发) | production (生产)
NODE_ENV=development

# 后端 Hono API 服务监听端口 (默认: 5123)
PORT=5123

# 发布脚本要求与锁文件匹配的 Bun 版本；BUN_BIN 可指定服务器上的绝对路径
BUN_VERSION=1.2.18
# BUN_BIN=/root/.bun/bin/bun

# ------------------------------------------------------------------------------
# 2. 数据库配置 (SQLite & Drizzle ORM)
# ------------------------------------------------------------------------------
# SQLite 数据库文件存放路径 (相对项目根目录或绝对路径)
DB_PATH=./data/curio.db

# Drizzle Kit CLI 迁移工具使用的数据库连接地址
DB_URL=./data/curio.db

# ------------------------------------------------------------------------------
# 3. AI 模型配置 (LLM Model Settings - 火山托管模型/Ark)
# ------------------------------------------------------------------------------
# === Model Provider (required) ===
# 火山引擎 / 方舟 API Key (必须配置)
LLM_API_KEY=

# === Optional: override defaults ===
# 模型提供商协议/兼容模式 (例如: anthropic, openai)
LLM_MODEL_PROVIDER=anthropic

# 调用的模型名称 / Endpoint ID (例如: ark-code-latest 或 ep-xxx)
LLM_MODEL_NAME=ark-code-latest

# 火山 API 服务 Endpoint Base URL
LLM_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/coding

# ------------------------------------------------------------------------------
# 4. 用户认证与安全配置 (Auth & Security)
# ------------------------------------------------------------------------------
# 用于签名和验证会话的密钥；生产环境必须为至少 32 字节的随机值，禁止提交真实值
JWT_SECRET=

# Token 有效期 (例如: 7d 表示 7 天, 24h 表示 24 小时)
JWT_EXPIRES_IN=7d

# 生产环境允许携带 Cookie 的前端来源，逗号分隔；开发环境可留空
ALLOWED_ORIGINS=https://your-domain.example

# 仅本地开发可设为 true；生产环境必须为 false 或未设置
ALLOW_HTTP_COOKIES=false

# ------------------------------------------------------------------------------
# 5. 前端 API 请求配置 (Vite App Settings)
# 注意: Vite 环境变量必须以 VITE_ 开头才能在前端代码中使用
# ------------------------------------------------------------------------------
# 前端向后端 API 发送请求的基础路径 (开发环境一般配置为 /api，由 Vite 代理转接到 localhost:3000)
VITE_API_BASE_URL=/api
