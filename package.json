{
  "name": "curio-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "bun run apps/api/src/server.ts",
    "db:push": "npx drizzle-kit push --config=packages/db/drizzle.config.ts",
    "db:seed": "bun packages/db/src/seed.ts",
    "db:migrate:phone": "bun scripts/migrate-phone-uniqueness.ts",
    "db:migrate:default-password": "bun scripts/migrate-default-password.ts",
    "content:repair-chapter1-vocab": "bun scripts/repair-chapter-1-vocab-contract.ts",
    "content:publish-pilot": "bun scripts/publish-pilot-content.ts",
    "content:bundle-pilot": "bun scripts/create-pilot-content-bundle.ts",
    "build": "npm run build --prefix apps/web",
    "test:api": "DB_PATH=.scratch/test-bootstrap.db bun test apps/api/tests",
    "test:content": "bun scripts/verify-content-and-vocab.ts",
    "audit:vocab": "bun scripts/audit-vocab-provenance.ts",
    "test:vocab-audit": "bun test scripts/audit-vocab-provenance.test.ts",
    "test:credential-safety": "bun scripts/verify-credential-safety.ts",
    "repair:content-contract": "bun scripts/repair-p1-content-contract.ts",
    "test:e2e": "playwright test",
    "quality:check": "npm run test:credential-safety && npm run build && npm run test:api && npm run test:content && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.0.0"
  }
}
